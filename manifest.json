{
  "manifest_version": 3,
  "name": "Restore Google Shopping Tab",
  "version": "1.0.0",
  "description": "Stellt den Shopping-Tab in den Google-Suchergebnissen wieder her.",
  "author": "Restore Google Shopping Tab",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.de/*",
    "https://www.google.at/*",
    "https://www.google.ch/*",
    "https://www.google.fr/*",
    "https://www.google.it/*",
    "https://www.google.es/*",
    "https://www.google.nl/*",
    "https://www.google.pl/*",
    "https://www.google.co.uk/*",
    "https://www.google.be/*",
    "https://www.google.se/*",
    "https://www.google.dk/*",
    "https://www.google.no/*",
    "https://www.google.fi/*",
    "https://www.google.pt/*",
    "https://www.google.ie/*"
  ],
  "action": {
    "default_icon": "assets/icon.svg",
    "default_popup": "src/ui/popup.html",
    "default_title": "Google Shopping-Tab wiederherstellen"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.de/search*",
        "https://www.google.at/search*",
        "https://www.google.ch/search*",
        "https://www.google.fr/search*",
        "https://www.google.it/search*",
        "https://www.google.es/search*",
        "https://www.google.nl/search*",
        "https://www.google.pl/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.be/search*",
        "https://www.google.se/search*",
        "https://www.google.dk/search*",
        "https://www.google.no/search*",
        "https://www.google.fi/search*",
        "https://www.google.pt/search*",
        "https://www.google.ie/search*"
      ],
      "js": ["src/scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "restore-google-shopping-tab@example.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
